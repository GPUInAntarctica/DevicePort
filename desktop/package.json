{
  "name": "deviceport-desktop",
  "version": "0.1.0",
  "description": "DevicePort desktop application (Electron wrapper around the Go daemon and its Web GUI)",
  "main": "main.js",
  "author": "DevicePort contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.deviceport.desktop",
    "productName": "DevicePort",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icons/**/*"],
    "extraResources": [
      { "from": "../bin", "to": "bin", "filter": ["deviceport*"] }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "icons/icon.ico" },
    "linux": { "target": ["AppImage", "deb"], "icon": "icons/icon.png", "category": "Network" },
    "mac": { "target": ["dmg"], "icon": "icons/icon.icns" }
  }
}
